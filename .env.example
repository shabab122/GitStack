# Application
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://gitstack:gitstack_dev_password@localhost:5432/gitstack?schema=public

# Authentication
# Use a long random value of at least 32 characters in real deployments.
JWT_SECRET=840b6f1bd5b8c4c1f0bf11cf91a13063121e3d670badd7b49f998500751d1d5226efd305daa8fe6da0b5d5d19e8affbd0484bff073b998bc9347a20da7f9f579
JWT_EXPIRES_IN=2h
AUTH_COOKIE_NAME=gitstack_session

# 32-byte AES-256-GCM key encoded as 64 hexadecimal characters.
# npm run setup generates this automatically for local development.
DATA_ENCRYPTION_KEY=8d30549c9106817d636415c406966c734cf533e13cc81d4035df019365661502

# Gitea collaboration integration
GITEA_BASE_URL=http://localhost:3002
# Token with permission to manage repositories. Keep this value secret.
GITEA_ADMIN_TOKEN=874d43df66668c407ccfe6444690ae03690918bc
# Optional: Gitea username used to own/create the GitStack organization.
GITEA_OWNER=shabab122
# Organization that owns GitStack team repositories. Create it automatically from the Instructor Gitea page.
GITEA_ORGANIZATION=gitstack
GITEA_WEBHOOK_SECRET=2c20c2e04ad6c3ac88080c3fa30bcfc832f594f8d6170b37fdf687af94948cdf

# Docker sandbox
SANDBOX_IMAGE=gitstack-sandbox:week1
SANDBOX_CONTAINER_PREFIX=gitstack-sandbox
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_MB=256
SANDBOX_PIDS_LIMIT=64
SANDBOX_WORKSPACE_MB=64
SANDBOX_TEMP_MB=32
SANDBOX_COMMAND_TIMEOUT_MS=10000
SANDBOX_DOCKER_TIMEOUT_MS=30000
SANDBOX_LIFETIME_MINUTES=60
SANDBOX_CLEANUP_INTERVAL_MS=300000
SANDBOX_MAX_PER_USER=3

# Compatibility-safe Week 1 hardening defaults.
# Enable these one at a time only after testing them on every team machine.
SANDBOX_READ_ONLY_ROOTFS=false
SANDBOX_DROP_ALL_CAPABILITIES=false
SANDBOX_NO_NEW_PRIVILEGES=false

# Browser terminal and sandbox networking
SANDBOX_TERMINAL_IDLE_MINUTES=30
SANDBOX_ISOLATED_NETWORK=none
SANDBOX_COLLABORATION_NETWORK=gitstack-sandbox-network
DOCKER_SOCKET_PATH=/var/run/docker.sock
