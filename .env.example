# Application
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# PostgreSQL (GitStack application data)
DATABASE_URL=postgresql://gitstack:gitstack_dev_password@localhost:5432/gitstack?schema=public

# Authentication
# `npm run setup` replaces the placeholders automatically on a fresh install.
JWT_SECRET=c357842f9efb6a9b69af146bdf9be5a1c2d595fa80416ae32608b44ac41b83f1b0f5218448763cfb38772140cd0c249b600a1b05d312e242e6b658ecd5d111c3
JWT_EXPIRES_IN=2h
AUTH_COOKIE_NAME=gitstack_session

# 32-byte AES-256-GCM key encoded as 64 hexadecimal characters.
DATA_ENCRYPTION_KEY=9eab72ca67d311e7e734f2ee30a15c3bac546143f8454434cfb9ac006e2a2b5b

# Gitea collaboration integration
GITEA_BASE_URL=http://localhost:3002
# Address reachable from collaboration sandboxes on the private Docker network.
GITEA_INTERNAL_BASE_URL=http://gitstack-gitea:3000
# Generate an access token in Gitea with repository, organization and user Read/Write scopes.
GITEA_ADMIN_TOKEN=40e8fd9bfa6da7f44a08f62552dfd2a5d04dc13f
# Optional service/admin username; organization creation can fall back to the token owner.
GITEA_OWNER=shabab122
GITEA_ORGANIZATION=gitstack
# `npm run setup` generates this if left as a placeholder.
GITEA_WEBHOOK_SECRET=260e75ab19f5ab8ed597fcae7e73a9a760dab79a
# Gitea container reaches the host GitStack API through host.docker.internal.
GITEA_WEBHOOK_TARGET_URL=http://host.docker.internal:3000/api/gitea/webhook

# Docker sandbox
SANDBOX_IMAGE=gitstack-sandbox:week1
SANDBOX_CONTAINER_PREFIX=gitstack-sandbox
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_MB=256
SANDBOX_PIDS_LIMIT=64
SANDBOX_WORKSPACE_MB=64
SANDBOX_TEMP_MB=32
SANDBOX_COMMAND_TIMEOUT_MS=10000
SANDBOX_DOCKER_TIMEOUT_MS=30000
SANDBOX_LIFETIME_MINUTES=120
SANDBOX_CLEANUP_INTERVAL_MS=300000
SANDBOX_MAX_PER_USER=3

# Compatibility-safe hardening defaults. Enable stricter flags only after local verification.
SANDBOX_READ_ONLY_ROOTFS=false
SANDBOX_DROP_ALL_CAPABILITIES=false
SANDBOX_NO_NEW_PRIVILEGES=false

# Browser terminal and sandbox networking
SANDBOX_TERMINAL_IDLE_MINUTES=30
SANDBOX_ISOLATED_NETWORK=none
SANDBOX_COLLABORATION_NETWORK=gitstack-sandbox-network
DOCKER_SOCKET_PATH=/var/run/docker.sock
